<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_users_form_inherit_reset_draft" model="ir.ui.view">
        <field name="name">res.users.form.reset.draft.security</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <!-- Añade la casilla en la pestaña Derechos de Acceso -->
            <xpath expr="//page[@name='access_rights']" position="inside">
                <group>
                    <field name="can_reset_account_move"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
